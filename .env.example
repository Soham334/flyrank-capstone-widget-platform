PORT=4100
HOST=127.0.0.1
BASE_URL=http://localhost:4100
DATABASE_PATH=./data/relay.sqlite
# Optional: hosted Postgres. Leave blank for local SQLite. Never commit a real URL.
DATABASE_URL=
DEMO_URL=http://localhost:5500
# Live mode uses free external services; mock mode stays deterministic and offline.
GEO_MODE=mock
MOCK_GEO_A_DOWN=false
MOCK_GEO_B_DOWN=false
NOTIFICATION_MODE=console
JOB_INTERVAL_MS=1000
JOB_MAX_ATTEMPTS=3
RATE_LIMIT_IP=20
RATE_LIMIT_WIDGET=100
RATE_WINDOW_MS=60000
SESSION_TTL_HOURS=24
COOKIE_SECURE=false
# Set to 0 normally. Only set to the exact number of trusted reverse proxy hops.
TRUST_PROXY_HOPS=0
